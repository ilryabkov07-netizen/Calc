<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1E1E1E">

    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="24sp"
        android:textColor="#AAAAAA"
        android:text=""
        android:padding="8dp"/>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:textSize="48sp"
        android:textColor="#FFFFFF"
        android:text="0"
        android:padding="8dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <Button android:id="@+id/btnClear" android:text="C"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btnDel" android:text="⌫"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btnPercent" android:text="%"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btnDiv" android:text="/"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#FF9800" android:layout_columnWeight="1"/>

        <Button android:id="@+id/btn7" android:text="7"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btn8" android:text="8"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btn9" android:text="9"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btnMul" android:text="×"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#FF9800" android:layout_columnWeight="1"/>

        <Button android:id="@+id/btn4" android:text="4"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btn5" android:text="5"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btn6" android:text="6"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btnSub" android:text="−"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#FF9800" android:layout_columnWeight="1"/>

        <Button android:id="@+id/btn1" android:text="1"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btn2" android:text="2"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btn3" android:text="3"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btnAdd" android:text="+"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#FF9800" android:layout_columnWeight="1"/>

        <Button android:id="@+id/btnDot" android:text="."
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btn0" android:text="0"
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_columnWeight="1"/>
        <Button android:id="@+id/btnEquals" android:text="="
            android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#4CAF50" android:layout_columnWeight="1" android:layout_columnSpan="2"/>
    </GridLayout>
</LinearLayout>